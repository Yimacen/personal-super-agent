# HTTP
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=./data/assistant.db
WORKSPACE_ROOT=./data/workspaces
BACKUP_DIR=./data/backups

# Internal worker authentication. Use at least 32 random bytes in production.
INTERNAL_API_TOKEN=replace-with-a-long-random-token
WORKER_ID=codex-worker-1
WORKER_POLL_MS=1000
CODEX_COMMAND=codex
CODEX_MODEL=
CODEX_ENV_ALLOWLIST=OPENAI_API_KEY,OPENAI_BASE_URL,OPENAI_ORG_ID,OPENAI_PROJECT_ID

# Approval delivery
APPROVAL_CHANNEL=dingtalk
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
APPROVER_REF=owner

# DingTalk personal-link cards (workbuddy/dws). Set APPROVAL_CHANNEL=dingtalk.
DINGTALK_DWS_COMMAND=dws
DINGTALK_BRIDGE_TOKEN=replace-with-a-long-random-token
DINGTALK_APPROVER_OPEN_ID=
DINGTALK_APPROVER_UID=
DINGTALK_CARD_CATALOG=https://dingtalk.com/card/a2ui/catalogs/public/catalog.json
DINGTALK_API_BASE_URL=http://127.0.0.1:4310
DINGTALK_LISTENER_DURATION=24h
DINGTALK_BRIDGE_RESTART_MS=3000

# Use "codex" for non-interactive full-access Codex execution.
WORKER_CODEX_MODE=codex
