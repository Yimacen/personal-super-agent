# HTTP
HOST=127.0.0.1
PORT=4310
DATABASE_PATH=./data/assistant.db
WORKSPACE_ROOT=./data/workspaces
BACKUP_DIR=./data/backups

# Internal worker authentication. Use at least 32 random bytes in production.
INTERNAL_API_TOKEN=replace-with-a-long-random-token
WORKER_ID=codex-worker-1
WORKER_POLL_MS=1000
CODEX_COMMAND=codex
CODEX_MODEL=

# Approval delivery
FEISHU_WEBHOOK_URL=
FEISHU_SIGNING_SECRET=
APPROVER_REF=owner

# The scripted adapter is deterministic and does not call Codex. Set to "codex"
# to run the local Codex CLI in a workspace-write sandbox.
WORKER_CODEX_MODE=scripted
