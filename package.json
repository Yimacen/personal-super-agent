{
  "name": "personal-super-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first personal super agent control plane",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "migrate": "tsx src/db/migrate-cli.ts",
    "backup": "tsx src/db/backup-cli.ts",
    "app": "tsx src/app/main.ts",
    "worker": "tsx src/worker/main.ts",
    "dingtalk:bridge": "tsx src/dingtalk/main.ts",
    "dev": "tsx src/app/main.ts",
    "demo": "tsx scripts/demo.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "fastify": "^5.6.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.12",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
